<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="22" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="STRIDE Console Setup" android:icon="@drawable/ic_setup" android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".SetupActivity" android:exported="true" android:screenOrientation="landscape">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <provider android:name=".PayloadProvider" android:authorities="dev.stride.setup.payload"
            android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
