    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@fitbit/sdk": "6.2.0-pre.1",
    "@fitbit/sdk-cli": "1.8.0-pre.10"
  },
  "overrides": {
    "@openid/appauth": "1.2.8"
  },
  "allowScripts": {
    "keytar@7.9.0": true,
    "usb@2.19.1": true
  }
